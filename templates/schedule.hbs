<div class="role-schedule-viewer">
  {{#unless configured}}
    <section class="role-schedule-empty">
      <div class="hero-mark"><i class="fas fa-calendar-plus" aria-hidden="true"></i></div>
      <h2>Este mundo aún no tiene horario</h2>
      {{#if isGM}}
        <p>Crea el horario del grupo. Se enviarán el nombre del mundo, el sistema y la lista de usuarios a
           <code>{{serverUrl}}</code>, y obtendrás un enlace para que cada jugador rellene su disponibilidad
           sin necesidad de tener Foundry abierto.</p>
        <button type="button" class="save-button" data-action="create-group">
          <i class="fas fa-plus"></i> Crear horario
        </button>
      {{else}}
        <p>El máster todavía no ha creado el horario del grupo.</p>
      {{/if}}
    </section>
  {{else}}
    <header class="role-schedule-hero">
      <div class="hero-mark"><i class="fas fa-calendar-check" aria-hidden="true"></i></div>
      <div class="hero-copy">
        <p class="eyebrow">{{#if groupSystem}}{{groupSystem}}{{else}}PLANIFICADOR DEL GRUPO{{/if}}</p>
        <h2>{{#if groupName}}{{groupName}}{{else}}Horarios de rol{{/if}}</h2>
      </div>
      <div class="hero-actions">
        <button type="button" class="save-button" data-action="open-web" title="Abre la web para rellenar tu disponibilidad">
          <i class="fas fa-pen-to-square"></i> Rellenar
        </button>
        <button type="button" class="icon-button" data-action="sync" title="{{#if isGM}}Enviar mundo y usuarios y recargar{{else}}Recargar{{/if}}">
          <i class="fas fa-rotate"></i>
        </button>
      </div>
    </header>

    {{#if isGM}}
      <section class="share-bar" aria-label="Enlace para el grupo">
        <label for="role-schedule-share-link"><i class="fas fa-link"></i> Enlace para el grupo</label>
        <input id="role-schedule-share-link" type="text" readonly value="{{shareLink}}" data-action="select-link">
        <button type="button" data-action="open-link" title="Abrir la web del grupo">
          <i class="fas fa-arrow-up-right-from-square"></i> Abrir
        </button>
        <button type="button" data-action="copy-link" title="Copiar el enlace para pasárselo al grupo">
          <i class="fas fa-copy"></i> Copiar
        </button>
      </section>
    {{/if}}

    <nav class="week-navigation" aria-label="Cambiar semana">
      <button type="button" class="icon-button" data-week-shift="-1" title="Semana anterior">
        <i class="fas fa-chevron-left"></i>
      </button>
      <div class="week-navigation-title">
        <span>{{#if isCurrentWeek}}ESTA SEMANA{{else}}SEMANA {{weekNumber}}{{/if}}</span>
        <strong>{{weekRange}}</strong>
      </div>
      <button type="button" class="today-button" data-action="current-week" {{#if isCurrentWeek}}disabled{{/if}}>
        <i class="fas fa-calendar-day"></i> Hoy
      </button>
      <button type="button" class="icon-button" data-week-shift="1" title="Semana siguiente">
        <i class="fas fa-chevron-right"></i>
      </button>
    </nav>

    {{#if error}}
      <section class="role-schedule-empty">
        <p class="error-text"><i class="fas fa-triangle-exclamation"></i> {{error}}</p>
        <div class="empty-actions">
          <button type="button" data-action="sync"><i class="fas fa-rotate"></i> Reintentar</button>
          {{#if isGM}}
            <button type="button" data-action="create-group"><i class="fas fa-plus"></i> Crear horario nuevo</button>
          {{/if}}
        </div>
      </section>
    {{else}}
      <section class="role-schedule-overview">
        <div class="section-heading">
          <div>
            <p class="eyebrow">TODO EL GRUPO</p>
            <h2>Cuándo podemos jugar</h2>
            {{#if bestCount}}<p class="best-legend"><i class="fas fa-circle"></i> Mayor coincidencia: {{bestCount}}</p>{{/if}}
            {{#if missing}}<p class="missing-legend">Sin rellenar: {{missing}}</p>{{/if}}
          </div>
          <div class="group-icon"><i class="fas fa-user-group"></i></div>
        </div>

        <div class="overview-days">
          {{#each overview}}
            <article class="overview-day">
              <header>
                <h3>{{label}}</h3>
                <span>{{dateLabel}}</span>
              </header>
              <div class="overview-slots">
                {{#each slots}}
                  <div class="overview-slot {{#if isBest}}best-slot{{/if}} {{#if @root.canSchedule}}gm-editable{{/if}}"
                       {{#if @root.canSchedule}}data-action="schedule-session" data-date="{{../dateKey}}" data-slot="{{key}}"
                       role="button" tabindex="0" title="Programar {{../label}} por la {{label}} como próxima sesión"{{else}}
                       title="{{label}}: {{users.length}} disponibles"{{/if}}>
                    <h4>
                      <span><i class="fas {{icon}}"></i>{{label}}</span>
                      <b>{{users.length}}</b>
                    </h4>
                    <div class="player-chips">
                      {{#each users}}
                        <span class="player-chip role-schedule-user" data-user-id="{{id}}" style="--user-color: {{color}}">
                          <i class="fas fa-circle"></i>{{name}}
                        </span>
                      {{else}}
                        <span class="nobody">—</span>
                      {{/each}}
                    </div>
                  </div>
                {{/each}}
              </div>
              {{#if notes.length}}
                <div class="overview-notes">
                  {{#each notes}}
                    <p><strong style="--user-color: {{color}}">{{name}}</strong><span>{{text}}</span></p>
                  {{/each}}
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}
  {{/unless}}
</div>
